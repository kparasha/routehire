{
  "name": "wastehire",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "npm run dev --workspace=@wastehire/web",
    "build": "npm run build --workspace=@wastehire/web",
    "ingest": "node worker/ingest/index.js",
    "mcp": "npm run start --workspace=@wastehire/mcp",
    "mcp:smoke": "npm run smoke --workspace=@wastehire/mcp",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "vitest": "^3.0.5",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4"
}
