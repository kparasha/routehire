{
  "name": "routehire",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "npm run dev --workspace=@routehire/web",
    "build": "npm run build --workspace=@routehire/web",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "vitest": "^3.0.5",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4"
}
